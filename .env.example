# ==============================================
# Pesquisa Eleitoral — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ==============================================

# Porta da aplicação
PORT=4444

# URL pública da aplicação (usada nos links de token enviados por WhatsApp/E-mail)
APP_URL=http://localhost:4444

# ==============================================
# PostgreSQL
# ==============================================
DATABASE_URL=postgresql://pesquisa_user:senha_segura@localhost:5432/pesquisa_eleitoral

# ==============================================
# Redis (BullMQ)
# ==============================================
REDIS_URL=redis://localhost:6379

# ==============================================
# JWT
# ==============================================
JWT_SECRET=troque_por_uma_string_secreta_longa_e_aleatoria

# ==============================================
# WhatsApp — Meta Cloud API
# ==============================================
META_WA_TOKEN=seu_token_de_acesso_permanente_meta
META_PHONE_ID=seu_phone_number_id_meta
META_TEMPLATE_NAME=nome_do_template_aprovado_na_meta

# ==============================================
# SMTP — E-mail
# ==============================================
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_smtp
SMTP_FROM="Pesquisa Eleitoral <noreply@seuprovedor.com>"
